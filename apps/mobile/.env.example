# Desarrollo local de The Worx (npm start / npm run start:worx).
#
# La API la decide la marca y el entorno (brands/index.js, campo `api`), no
# este archivo. Si EXPO_PUBLIC_API_URL esta puesta tiene que ser EXACTAMENTE la
# de esa marca y entorno, o app.config.js para el arranque. Para HDG usa
# `npm run start:hdg`, que fija APP_BRAND=hdg, APP_ENV=sandbox y su URL.
#
#   The Worx (production): https://core.theworxoffices.com/api/v1
#   HDG (sandbox):         https://core.hdgexecutivesuites.com/api/v1
EXPO_PUBLIC_API_URL=https://core.theworxoffices.com/api/v1

# Clave publicable de Stripe (la misma que VITE_STRIPE_PUBLISHABLE_KEY en el web).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
