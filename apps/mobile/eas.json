{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base-development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },

    "base-preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },

    "base-simulator": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "ios": {
        "simulator": true
      }
    },

    "base-production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    },

    "worx-development": {
      "extends": "base-development",
      "env": { "APP_BRAND": "the_worx" }
    },
    "worx-preview": {
      "extends": "base-preview",
      "env": { "APP_BRAND": "the_worx" }
    },
    "worx-simulator": {
      "extends": "base-simulator",
      "env": { "APP_BRAND": "the_worx" }
    },
    "worx-production": {
      "extends": "base-production",
      "env": { "APP_BRAND": "the_worx" }
    },

    "hdg-development": {
      "extends": "base-development",
      "env": { "APP_BRAND": "hdg" }
    },
    "hdg-preview": {
      "extends": "base-preview",
      "env": { "APP_BRAND": "hdg" }
    },
    "hdg-simulator": {
      "extends": "base-simulator",
      "env": { "APP_BRAND": "hdg" }
    },
    "hdg-production": {
      "extends": "base-production",
      "env": { "APP_BRAND": "hdg" }
    }
  },
  "submit": {
    "worx-production": {},
    "hdg-production": {}
  }
}
