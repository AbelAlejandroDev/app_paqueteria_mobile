{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base-development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "base-preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "base-simulator": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "ios": {
        "simulator": true
      }
    },
    "base-production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    },
    "worx-development": {
      "extends": "base-development",
      "env": {
        "APP_BRAND": "the_worx",
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://core.theworxoffices.com/api/v1"
      }
    },
    "worx-preview": {
      "extends": "base-preview",
      "env": {
        "APP_BRAND": "the_worx",
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://core.theworxoffices.com/api/v1"
      }
    },
    "worx-simulator": {
      "extends": "base-simulator",
      "env": {
        "APP_BRAND": "the_worx",
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://core.theworxoffices.com/api/v1"
      }
    },
    "worx-production": {
      "extends": "base-production",
      "env": {
        "APP_BRAND": "the_worx",
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://core.theworxoffices.com/api/v1"
      }
    },
    "worx-production-apk": {
      "extends": "worx-production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "hdg-development": {
      "extends": "base-development",
      "env": {
        "APP_BRAND": "hdg",
        "APP_ENV": "sandbox",
        "EXPO_PUBLIC_API_URL": "https://sandbox-core.hdgexecutivesuites.com/api/v1"
      }
    },
    "hdg-preview": {
      "extends": "base-preview",
      "env": {
        "APP_BRAND": "hdg",
        "APP_ENV": "sandbox",
        "EXPO_PUBLIC_API_URL": "https://sandbox-core.hdgexecutivesuites.com/api/v1"
      }
    },
    "hdg-simulator": {
      "extends": "base-simulator",
      "env": {
        "APP_BRAND": "hdg",
        "APP_ENV": "sandbox",
        "EXPO_PUBLIC_API_URL": "https://sandbox-core.hdgexecutivesuites.com/api/v1"
      }
    },
    "hdg-testflight-sandbox": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "testflight-sandbox",
      "environment": "preview",
      "env": {
        "APP_BRAND": "hdg",
        "APP_ENV": "sandbox",
        "EXPO_PUBLIC_API_URL": "https://sandbox-core.hdgexecutivesuites.com/api/v1"
      }
    },
    "hdg-production": {
      "extends": "base-production",
      "env": {
        "APP_BRAND": "hdg",
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://core.hdgexecutivesuites.com/api/v1"
      }
    }
  },
  "submit": {
    "worx-production": {
      "ios": {
        "ascAppId": "6822867406"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "hdg-testflight-sandbox": {
      "ios": {
        "ascAppId": "6835613644",
        "appleTeamId": "3KX6P6C79Q"
      }
    },
    "hdg-production": {
      "ios": {
        "ascAppId": "6835613644",
        "appleTeamId": "3KX6P6C79Q"
      }
    }
  }
}
