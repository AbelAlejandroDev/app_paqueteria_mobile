# URL de la API. Debe ser HTTPS en build de producción: Android bloquea el
# tráfico en claro por defecto y iOS lo rechaza por ATS.
EXPO_PUBLIC_API_URL=https://api.theworxoffices.com/api/v1

# Clave publicable de Stripe (la misma que VITE_STRIPE_PUBLISHABLE_KEY en el web).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
